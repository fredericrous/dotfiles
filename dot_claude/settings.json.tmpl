  },
  "permissions": {
    "allow": [
      "Bash(export KUBECONFIG=*)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(npm run typecheck *)",
      "Bash(npm test *)",
      "Bash(npx vitest run *)",
      "Bash(npx playwright test *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(uvx ruff@latest check *)",
      "Bash(uvx ruff check *)",
      "Bash(uv run --frozen pytest *)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__list_network_requests"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/relais hook",
            "timeout": 19
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__chrome-devtools__take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/Users/fredericrous/.claude/tools/worktree-sweep/sweep.py",
              "--nudge"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/relais hook",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -n \"$(find . -maxdepth 3 -name package.json -not -path \"*/node_modules/*\" -exec grep -l \"@duro-app/\" {} + 2>/dev/null)\" ] || exit 0; [ -e .claude/hooks/duro-catalog.sh ] && exit 0; exec npx -y @duro-app/cli@^6 context'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
