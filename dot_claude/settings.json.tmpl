          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "LSP",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/relais hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/amont-agent",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/relais hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/relais hook",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/relais hook",
            "timeout": 10
          }
