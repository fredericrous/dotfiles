#!/bin/bash
# author-rewrite   Replace $old_email by $name $new_email in history
SCRIPT_NAME=$(basename "$0" | sed 's/git-//')

if [ "$#" -eq 0 ] || [ "$#" -lt 3 ]; then
    printf 'Usage:\n    git %s <old_email> <name> <new_email>\n' "$SCRIPT_NAME"
    exit 1;
fi

git filter-repo --mailmap <(echo "$2 <$3> <$1>") "${@:4}"
