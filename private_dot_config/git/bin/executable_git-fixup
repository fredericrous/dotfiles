#!/bin/bash
# fixup            Commit Staged files to a different commit $sha_or_alias
SCRIPT_NAME=$(basename "$0" | sed 's/git-//')

if [ "$#" -eq 0 ]; then
    printf 'Usage:\n    git %s <sha>\n' "$SCRIPT_NAME"
    exit 1;
fi

SHA=$(git rev-parse "$1")
if ! git commit --fixup="$SHA" "${@:2}"; then
    EDITOR=true git rebase -i --autostash --autosquash "$SHA^"
fi
