[branch]
	autosetupmerge = always
	autosetuprebase = always
	sort = -committerdate
[core]
	autocrlf = false

	editor = "/usr/bin/vim"

	eol = native
	excludesfile = ~/.config/git/gitignore
	pager = delta
	# Make `git rebase` safer on macOS.
	# More info: <http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/>
	trustctime = false
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space
	attributesfile = ~/.config/git/attributes
[commit]
	template = ~/.config/git/amont/message
[credential]
	helper = cache
[diff]
	tool = p4merge
[diff "bin"]
	textconv = hexdump -v -C
[difftool]
	prompt = false
	keepBackup = false
[difftool "p4merge"]
	cmd = p4merge "$LOCAL" "$REMOTE"
	keepTemporaries = false
	trustExitCode = false
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[http]
	postBuffer = 157286400
[init]
	defaultBranch = main
	templatedir = ~/.config/git/amont/templates
[merge]
	tool = p4merge
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "p4merge"]
	cmd = p4merge "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
	keepTemporaries = false
	trustExitCode = false
[pull]
	rebase = true
[rebase]
	autoStash = true
[include]
	path = alias.toml
	path = style.toml
[includeIf "gitdir:~/.local/share/chezmoi/**"]
	path = ~/.config/git/config_perso.toml
[includeIf "gitdir/i:~/Developer/Perso/**"]
	path = ~/.config/git/shared_config.toml
	path = ~/.config/git/config_perso.toml
{{- if .work.dir }}
[includeIf "gitdir/i:~/Developer/{{ .work.dir }}/**"]
	path = ~/.config/git/shared_config.toml
	path = ~/.config/git/{{ .work.config }}
{{- end }}
[http "https://{{ .forge.host }}/"]
	sslCert = /Users/fredericrous/certs/gitea-client-active.pem
[credential "https://github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
[greengate "cluster"]
	image = {{ .forge.host }}/fredericrous/gate-runner:main-6a5cf6b@sha256:01e1c07addc406df31d733458629abbbc34110a1d2b6463d572a75e4f9fb9b16
	kubeconfig = ~/.config/greengate/kube/homelab.yaml
	snapshotfetch = http://forgejo-http.forgejo.svc.cluster.local:3000/greengate-snapshots/{repo}.git
	snapshotremote = git@{{ .forge.host }}:greengate-snapshots/{repo}.git
	signer = in-cluster
[greenbelay "bare-stash-pop"]
	stance = deny
[greenbelay "no-verify"]
	stance = deny
[greenbelay "gh-pr-merge-auto"]
	stance = deny
[greenbelay "git-add-broad"]
	stance = observe
[greenbelay "stdin-hang"]
	stance = deny
[greenbelay "sed-in-place"]
	stance = deny
	shadow = 0.1
[greenbelay "foreground-poll"]
	stance = deny
	shadow = 0.1
[greenbelay "stat-bsd-format"]
	stance = deny
[greenbelay "worktree-remove-force"]
	stance = deny
[greenbelay "plan-review.dotfiles"]
	path = ~/.local/share/chezmoi
[greenbelay "glob-in-flag-value"]
	stance = deny
	shadow = 0.1
[greenbelay "equals-separator"]
	stance = deny
	shadow = 0.1
[greenbelay "implementation-review"]
	stance = deny
[greenbelay "push-preview"]
	stance = deny
[greenbelay "publish-without-skill"]
	stance = deny
[greenbelay "file-reread"]
	stance = advise
[greenbelay "lint-suppression-added"]
	stance = deny
[greenbelay "test-output-trimmed"]
	stance = deny
	shadow = 0.1
[greenbelay "workspace-root-write"]
	shadow = 0.1
[greenbelay "plan-review"]
	root = ~/Developer/Perso
[greenbelay]
	opener = \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" {}
[greenbelay "unsplit-expansion"]
	stance = advise
[greenbelay "read-unbounded-large"]
	stance = deny
[greenbelay "whole-file-dump"]
	stance = deny
[greenbelay "symbol-grep-not-lsp"]
	denyagents = relais:relais-worker-haiku-*
[greengate]
	snapshotDeps = reuse
[greenbelay "clear-at-boundary"]
	stance = deny
